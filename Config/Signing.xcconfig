// Optional local overrides. Copy Local.xcconfig.example to Local.xcconfig.
#include? "Local.xcconfig"

CODE_SIGN_STYLE = Automatic
// Team ID plus a shared suffix. Empty DEVELOPMENT_TEAM leaves a leading dot;
// the app ignores that and keeps the cookie in the default keychain until a
// team is set, which is what the widget extension needs in order to read it.
GROK_KEYCHAIN_ACCESS_GROUP = $(DEVELOPMENT_TEAM).com.charlesdardaman.grok-widget.shared
